# Copy to .env (or export in your shell). Everything is optional: without keys
# AdLift runs on the offline baseline model and the stub language model.

# Hosted TabPFN 3.5 -- the backend this project is built for.
# Create a key at https://ux.priorlabs.ai (Prior Labs), then:
TABPFN_TOKEN=

# Claude, for reading banner images and writing copy variants.
ANTHROPIC_API_KEY=
# Override the model used for rewrites (default: claude-opus-5).
# ADLIFT_LLM_MODEL=claude-opus-5

# Force a model backend for the CLI / MCP server: auto | client | local | baseline
# ADLIFT_BACKEND=auto

# Optional: path to a clone of https://github.com/jr2021/Do-PFN to enable `--dopfn`.
# ADLIFT_DOPFN_PATH=/path/to/Do-PFN
